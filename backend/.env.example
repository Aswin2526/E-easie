EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password-no-spaces
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Optional SMTP overrides
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
# Copy to .env. Django 4.2 is pinned for XAMPP MariaDB 10.4 compatibility.
USE_MYSQL=1
MYSQL_DATABASE=eeasie
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# eSewa (optional). Defaults match eSewa UAT / EPAYTEST.
# PUBLIC_BACKEND_BASE must match where Django runs (eSewa redirects the browser here).
# FRONTEND_ORIGIN = where users return after success/failure redirects.
# FRONTEND_ORIGIN=http://localhost:5173
# PUBLIC_BACKEND_BASE=http://127.0.0.1:8000
# ESEWA_VERIFY_STATUS=0
# ESEWA_VERIFY_RESPONSE_SIGNATURE=1
